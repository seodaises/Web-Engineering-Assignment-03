rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an authenticated admin?
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: is this my own user document?
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // === Users collection ===
    match /users/{uid} {
      // Any logged-in user can read other users (needed for chat list / user picker)
      allow read: if request.auth != null;

      // Create your own user doc only (on signup)
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user';

      // Update: yourself (e.g. lastLoginAt) OR an admin (to flip roles)
      allow update: if isOwner(uid) || isAdmin();

      // Delete: only yourself (on account deletion)
      allow delete: if isOwner(uid);
    }

    // === Profiles collection ===
    match /profiles/{profileId} {
      // Public read - anyone can browse profiles
      allow read: if true;

      // Create: logged-in users only, and createdBy must match their uid
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // Update: only the creator (admins cannot edit others' profiles per design)
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Delete: creator OR admin (admin moderation power)
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // === Chats collection ===
    match /chats/{chatId} {
      // Read: any logged-in user can attempt a read.
      // If the doc exists, they must be a participant; if it doesn't exist,
      // getDoc just returns "not found" which is what our code expects.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);

      // Create: must be a participant, must include exactly 2 participants
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      // Update: only participants (used for lastMessage, unreadCount, etc.)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Don't allow deleting chats from the client
      allow delete: if false;

      // === Messages subcollection ===
      match /messages/{messageId} {
        // Read messages only if you're a participant in the parent chat
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Create: must be a participant AND senderId must equal your uid
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Messages are immutable - can't edit or delete from client
        allow update, delete: if false;
      }
    }
  }
}
